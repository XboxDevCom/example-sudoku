<Page
    x:Class="Sudoku.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sudoku"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="48,24,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   HorizontalAlignment="Center"
                   FontSize="42"
                   FontWeight="Bold"
                   Text="Sudoku"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
            <TextBlock x:Name="StatusText"
                       FontSize="20"
                       Text="Bereit"/>
        </StackPanel>

        <Grid Grid.Row="2"
              x:Name="BoardContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MaxWidth="540"
              MaxHeight="540"/>

        <StackPanel Grid.Row="3"
                    x:Name="NumberPad"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button x:Name="NewGameButton"
                     MinHeight="48"
                    Content="Neues Spiel"
                    FontSize="20"
                    Padding="24,12"
                    Margin="0,0,16,0"
                    Click="NewGameButton_Click"
                    XYFocusRight="CheckButton"/>
            <Button x:Name="CheckButton"
                     MinHeight="48"
                    Content="Prüfen"
                    FontSize="20"
                    Padding="24,12"
                    Click="CheckButton_Click"
                    XYFocusLeft="NewGameButton"/>
        </StackPanel>
    </Grid>
</Page>
